{
  "name": "days-capstone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "dev": "turbo run dev:app",
    "dev:app": "portless run next dev",
    "build": "turbo run build:app",
    "build:app": "next build",
    "start": "next start",
    "db:start": "supabase start --runtime native",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "check": "vp check",
    "fix": "vp check --fix",
    "typecheck": "turbo run typecheck:app",
    "typecheck:app": "tsc --noEmit",
    "typegen": "turbo run typegen:app",
    "typegen:app": "next typegen",
    "test": "turbo run test:app db:check:app",
    "test:app": "bun test --conditions=react-server",
    "test:integration": "turbo run test:integration:app",
    "test:integration:app": "bun --env-file=.env.local test --conditions=react-server ./src/lib/data/data.integration.ts ./src/lib/supabase/secrets.integration.ts",
    "test:evaluation": "bun --env-file=.env.local --conditions=react-server ./src/lib/flagging/evaluation.live.ts",
    "test:live": "bun --env-file=.env.local --conditions=react-server ./src/lib/flagging/flagging.live.ts",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db --local",
    "db:generate": "drizzle-kit generate",
    "db:types": "supabase gen types --local --lang typescript > node_modules/.database.types.ts && mv node_modules/.database.types.ts src/lib/supabase/database.types.ts && vp check --fix src/lib/supabase/database.types.ts",
    "db:migrate": "supabase migration up --local",
    "db:check": "turbo run db:check:app",
    "db:check:app": "drizzle-kit check"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.68",
    "@base-ui/react": "1.8.0",
    "@fontsource/inter": "5.3.0",
    "@react-pdf/renderer": "4.9.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-table": "9.2.8",
    "ai": "7.0.140",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "drizzle-orm": "0.45.4",
    "next": "16.4.0",
    "nuqs": "2.10.2",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "shadcn": "4.21.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@shadcn/lint": "0.2.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@tanstack/query-core": "5.104.1",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "portless": "0.15.7",
    "supabase": "2.120.0",
    "tailwindcss": "4.3.3",
    "turbo": "2.11.7",
    "typescript": "5.9.3",
    "ultracite": "7.12.4",
    "vite-plus": "1.1.0"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
